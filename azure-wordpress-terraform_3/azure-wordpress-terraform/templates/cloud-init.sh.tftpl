#!/bin/bash
# Bootstraps each WordPress VM in the scale set.
# Rendered by Terraform templatefile(): only $${...} placeholders are Terraform values.
set -euo pipefail
exec > >(tee -a /var/log/wp-bootstrap.log) 2>&1
echo "=== WordPress bootstrap started $(date -u) ==="

export DEBIAN_FRONTEND=noninteractive
SHARE_MNT=/mnt/wpshared
WP_ROOT=$SHARE_MNT/wordpress

# ---------------------------------------------------------------------------
# 1. Packages: NGINX, PHP-FPM 8.1 + WordPress extensions, NFS client
# ---------------------------------------------------------------------------
apt-get update -y
apt-get install -y nginx php8.1-fpm php8.1-mysql php8.1-curl php8.1-gd php8.1-mbstring \
  php8.1-xml php8.1-zip php8.1-intl php8.1-bcmath php-imagick nfs-common jq curl

# ---------------------------------------------------------------------------
# 2. Mount the shared Azure Files NFS share (same content on every VM)
# ---------------------------------------------------------------------------
mkdir -p $SHARE_MNT
if ! grep -q "$SHARE_MNT" /etc/fstab; then
  echo "${storage_account}.file.core.windows.net:/${storage_account}/${share_name} $SHARE_MNT nfs vers=4,minorversion=1,sec=sys,nconnect=4,_netdev,nofail 0 0" >> /etc/fstab
fi
for i in $(seq 1 30); do
  mount -a && mountpoint -q $SHARE_MNT && break
  echo "Waiting for NFS mount ($i)..."; sleep 10
done
mountpoint -q $SHARE_MNT || { echo "NFS mount failed"; exit 1; }

# ---------------------------------------------------------------------------
# 3. Read the DB password from Key Vault with the VM's managed identity
# ---------------------------------------------------------------------------
TOKEN=""
for i in $(seq 1 30); do
  TOKEN=$(curl -s -H Metadata:true \
    "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id=${identity_client_id}" \
    | jq -r '.access_token // empty') || true
  [ -n "$TOKEN" ] && break
  echo "Waiting for managed identity token ($i)..."; sleep 10
done
DB_PASS=""
for i in $(seq 1 30); do
  DB_PASS=$(curl -s -H "Authorization: Bearer $TOKEN" \
    "https://${key_vault_name}.vault.azure.net/secrets/${db_secret_name}?api-version=7.4" \
    | jq -r '.value // empty') || true
  [ -n "$DB_PASS" ] && break
  echo "Waiting for Key Vault access ($i)..."; sleep 10
done
[ -n "$DB_PASS" ] || { echo "Could not read DB password from Key Vault"; exit 1; }

# ---------------------------------------------------------------------------
# 4. Install WordPress ONCE onto the share (first VM wins the lock)
# ---------------------------------------------------------------------------
install_wordpress() {
  if [ -f "$WP_ROOT/wp-config.php" ]; then
    echo "WordPress already installed on share - skipping."
    return
  fi
  echo "Installing WordPress ${wp_version} onto shared storage..."
  TMP=$(mktemp -d)
  if [ "${wp_version}" = "latest" ]; then
    curl -fsSL https://wordpress.org/latest.tar.gz -o $TMP/wp.tgz
  else
    curl -fsSL https://wordpress.org/wordpress-${wp_version}.tar.gz -o $TMP/wp.tgz
  fi
  tar -xzf $TMP/wp.tgz -C $TMP
  mkdir -p $WP_ROOT
  cp -a $TMP/wordpress/. $WP_ROOT/

  cat > $WP_ROOT/wp-config.php <<'PHP'
<?php
define('DB_NAME',     '__DB_NAME__');
define('DB_USER',     '__DB_USER__');
define('DB_PASSWORD', '__DB_PASS__');
define('DB_HOST',     '__DB_HOST__');
define('DB_CHARSET',  'utf8mb4');
define('DB_COLLATE',  '');
define('MYSQL_CLIENT_FLAGS', MYSQLI_CLIENT_SSL); // MySQL Flexible Server enforces TLS

define('AUTH_KEY',         '__SALT1__');
define('SECURE_AUTH_KEY',  '__SALT2__');
define('LOGGED_IN_KEY',    '__SALT3__');
define('NONCE_KEY',        '__SALT4__');
define('AUTH_SALT',        '__SALT5__');
define('SECURE_AUTH_SALT', '__SALT6__');
define('LOGGED_IN_SALT',   '__SALT7__');
define('NONCE_SALT',       '__SALT8__');

// Site is always served over HTTPS by Azure Front Door
$_SERVER['HTTPS'] = 'on';
define('WP_HOME',    'https://__SITE_HOST__');
define('WP_SITEURL', 'https://__SITE_HOST__');
define('FORCE_SSL_ADMIN', true);

// Cron runs from system cron on each VM instead of on page views
define('DISABLE_WP_CRON', true);
define('WP_MEMORY_LIMIT', '256M');
define('AUTOMATIC_UPDATER_DISABLED', false);

$table_prefix = 'wp_';
define('WP_DEBUG', false);
if ( ! defined('ABSPATH') ) { define('ABSPATH', __DIR__ . '/'); }
require_once ABSPATH . 'wp-settings.php';
PHP

  sed -i "s|__DB_NAME__|${db_name}|; s|__DB_USER__|${db_user}|; s|__DB_HOST__|${db_host}|; s|__SITE_HOST__|${site_host}|g" $WP_ROOT/wp-config.php
  sed -i "s|__DB_PASS__|$DB_PASS|" $WP_ROOT/wp-config.php
  for n in 1 2 3 4 5 6 7 8; do
    SALT=$(openssl rand -base64 48 | tr -d '\n|')
    sed -i "s|__SALT$${n}__|$SALT|" $WP_ROOT/wp-config.php
  done

  chown -R www-data:www-data $WP_ROOT
  find $WP_ROOT -type d -exec chmod 755 {} \;
  find $WP_ROOT -type f -exec chmod 644 {} \;
  chmod 640 $WP_ROOT/wp-config.php
  rm -rf $TMP
}
export -f install_wordpress
export WP_ROOT DB_PASS
flock $SHARE_MNT/.install.lock bash -c install_wordpress

# ---------------------------------------------------------------------------
# 5. Local health endpoint (checks this VM can serve PHP + sees the share).
#    Deliberately does NOT check MySQL, so a DB failover never marks every VM
#    unhealthy at once.
# ---------------------------------------------------------------------------
mkdir -p /var/www/health
cat > /var/www/health/health.php <<'PHP'
<?php
if (file_exists('/mnt/wpshared/wordpress/wp-config.php')) { http_response_code(200); echo 'OK'; }
else { http_response_code(503); echo 'SHARE_MISSING'; }
PHP

# ---------------------------------------------------------------------------
# 6. PHP-FPM + OPcache tuning
# ---------------------------------------------------------------------------
PHP_INI=/etc/php/8.1/fpm/php.ini
sed -i 's/^upload_max_filesize.*/upload_max_filesize = 64M/' $PHP_INI
sed -i 's/^post_max_size.*/post_max_size = 64M/' $PHP_INI
sed -i 's/^memory_limit.*/memory_limit = 256M/' $PHP_INI
cat > /etc/php/8.1/fpm/conf.d/99-opcache.ini <<'INI'
opcache.enable=1
opcache.memory_consumption=256
opcache.interned_strings_buffer=32
opcache.max_accelerated_files=20000
opcache.validate_timestamps=1
opcache.revalidate_freq=60
INI
POOL=/etc/php/8.1/fpm/pool.d/www.conf
sed -i 's/^pm = .*/pm = dynamic/' $POOL
sed -i 's/^pm.max_children = .*/pm.max_children = 60/' $POOL
sed -i 's/^pm.start_servers = .*/pm.start_servers = 12/' $POOL
sed -i 's/^pm.min_spare_servers = .*/pm.min_spare_servers = 8/' $POOL
sed -i 's/^pm.max_spare_servers = .*/pm.max_spare_servers = 20/' $POOL

# ---------------------------------------------------------------------------
# 7. NGINX site: sets Cache-Control so Front Door caches anonymous pages
# ---------------------------------------------------------------------------
cat > /etc/nginx/sites-available/wordpress <<'NGINX'
# Anonymous visitors get a 5-minute edge-cacheable page; logged-in users never cached
map $http_cookie $wp_cache_by_cookie {
    default                    "public, max-age=300, s-maxage=300";
    ~*wordpress_logged_in      "private, no-store";
    ~*wp-postpass              "private, no-store";
    ~*comment_author           "private, no-store";
}
map $request_uri $wp_cache_control {
    default                    $wp_cache_by_cookie;
    ~*/wp-admin/               "private, no-store";
    ~*/wp-login\.php           "private, no-store";
    ~*/wp-json/                "private, no-store";
    ~*/wp-cron\.php            "private, no-store";
    ~*preview=true             "private, no-store";
}

server {
    listen 80 default_server;
    server_name _;
    root /mnt/wpshared/wordpress;
    index index.php;
    client_max_body_size 64m;

    location = /health.php {
        root /var/www/health;
        access_log off;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
    }

    location = /xmlrpc.php { deny all; }
    location ~ /\.(?!well-known) { deny all; }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_read_timeout 60s;
        fastcgi_hide_header Cache-Control;
        fastcgi_hide_header Expires;
        fastcgi_hide_header Pragma;
        add_header Cache-Control $wp_cache_control always;
    }

    location ~* \.(css|js|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }
}
NGINX
ln -sf /etc/nginx/sites-available/wordpress /etc/nginx/sites-enabled/wordpress
rm -f /etc/nginx/sites-enabled/default
sed -i 's/worker_connections .*/worker_connections 4096;/' /etc/nginx/nginx.conf

systemctl enable --now php8.1-fpm nginx
systemctl restart php8.1-fpm
nginx -t && systemctl reload nginx

# ---------------------------------------------------------------------------
# 8. WP-Cron via system cron (random offset so VMs don't all fire together)
# ---------------------------------------------------------------------------
OFFSET=$((RANDOM % 4))
echo "$OFFSET-59/5 * * * * www-data php $WP_ROOT/wp-cron.php >/dev/null 2>&1" > /etc/cron.d/wordpress
chmod 644 /etc/cron.d/wordpress

echo "=== WordPress bootstrap finished $(date -u) ==="
